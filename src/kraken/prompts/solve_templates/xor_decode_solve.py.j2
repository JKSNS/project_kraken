#!/usr/bin/env python3
"""XOR decode solver -- auto-generated from template."""

def main():
    encrypted = bytes.fromhex("{{ encrypted_hex }}")
    {% if key_hex %}
    key = bytes.fromhex("{{ key_hex }}")
    {% elif key_string %}
    key = {{ key_string | tojson }}.encode()
    {% else %}
    key = bytes([{{ key_byte | default(0) }}])
    {% endif %}

    result = bytes(e ^ key[i % len(key)] for i, e in enumerate(encrypted))

    try:
        decoded = result.decode('ascii', errors='replace')
        print(decoded)
    except Exception:
        print(result.hex())
        print(result)

if __name__ == '__main__':
    main()
