#!/usr/bin/env python3
"""Common crypto pattern solver -- auto-generated from template."""
import base64
import string

def caesar_decode(text, shift):
    result = []
    for c in text:
        if c in string.ascii_lowercase:
            result.append(chr((ord(c) - ord('a') - shift) % 26 + ord('a')))
        elif c in string.ascii_uppercase:
            result.append(chr((ord(c) - ord('A') - shift) % 26 + ord('A')))
        else:
            result.append(c)
    return ''.join(result)

def main():
    algorithm = "{{ algorithm }}"
    data = "{{ encoded_data }}"
    {% if key %}
    key = "{{ key }}"
    {% else %}
    key = None
    {% endif %}

    if algorithm == "base64":
        try:
            print(base64.b64decode(data).decode())
        except Exception:
            # Try multiple rounds
            decoded = data
            for _ in range(5):
                try:
                    decoded = base64.b64decode(decoded).decode()
                except Exception:
                    break
            print(decoded)

    elif algorithm == "caesar":
        if key:
            print(caesar_decode(data, int(key)))
        else:
            for shift in range(26):
                result = caesar_decode(data, shift)
                print(f"shift={shift}: {result}")

    elif algorithm == "substitution":
        # Try frequency analysis or known mapping
        if key:
            table = str.maketrans(key, string.ascii_lowercase[:len(key)])
            print(data.translate(table))
        else:
            print(f"Substitution cipher detected, data: {data}")

    elif algorithm == "rc4":
        if key:
            S = list(range(256))
            j = 0
            key_bytes = key.encode() if isinstance(key, str) else key
            for i in range(256):
                j = (j + S[i] + key_bytes[i % len(key_bytes)]) % 256
                S[i], S[j] = S[j], S[i]

            data_bytes = bytes.fromhex(data) if all(c in '0123456789abcdefABCDEF' for c in data) else data.encode()
            i = j = 0
            result = []
            for byte in data_bytes:
                i = (i + 1) % 256
                j = (j + S[i]) % 256
                S[i], S[j] = S[j], S[i]
                result.append(byte ^ S[(S[i] + S[j]) % 256])
            print(bytes(result).decode(errors='replace'))

    else:
        print(f"Unknown algorithm: {algorithm}")

if __name__ == '__main__':
    main()
